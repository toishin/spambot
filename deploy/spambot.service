[Unit]
Description=Discord Spambot
After=network.target

[Service]
User=spambot
Group=spambot
WorkingDirectory=/home/spambot/spambot
EnvironmentFile=/home/spambot/spambot/.env
ExecStart=/home/spambot/spambot/venv/bin/python /home/spambot/spambot/main.py
Restart=always
RestartSec=5
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=spambot

[Install]
WantedBy=multi-user.target
